SECRET_KEY=generate-a-random-secret-with-at-least-32-characters

# Create an administrator on startup. Use a unique password (12-72 UTF-8 bytes).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-password

# Razorpay Dashboard > Test mode > API Keys
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Configure a Razorpay webhook for payment.captured and payment.failed.
# Set the same secret here and in the Razorpay webhook configuration.
RAZORPAY_WEBHOOK_SECRET=replace_me
